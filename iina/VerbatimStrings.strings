"settings.immersive3D.section" = "Immersive 3D";
"settings.immersive3DDepthModel.label" = "Depth Model";
"settings.immersive3DDepthModel.desc" = "Depth Anything V2 Small is the default (Apple Core ML). Depth Anything 3 Small needs a package from other/convert_depth_anything_3.py. Changing this reloads the model.";
"settings.immersive3DDepthModel.items.0" = "Depth Anything V2 Small";
"settings.immersive3DDepthModel.items.1" = "Depth Anything 3 Small";
"settings.immersive3DAutoGlassesDisplay.label" = "Automatically set up glasses display";
"settings.immersive3DAutoGlassesDisplay.desc" = "When Play on Glasses starts, a mirrored NXTWEAR S is switched to an extended display for this login session. Mirroring is restored when Play on Glasses stops. The check runs again after the glasses change between 2D and 3D, because mirroring can return with that mode switch.";

"settings.iptv.section" = "IPTV";
"settings.iptvTMDBAPIKey.label" = "TMDB API Key";
"settings.iptvTMDBAPIKey.desc" = "Optional. A v3 key from themoviedb.org fills missing posters and plots for Movies and Series. A key that starts with ey is sent as a v4 bearer token. The key is stored in preferences, not the Keychain. Leave this blank to use only what the provider sends.";

"settings.liveCaption.section" = "Live captions";
"settings.liveCaptionEnabled.label" = "Live auto subtitles";
"settings.liveCaptionEnabled.desc" = "On-device speech to text for files, live TV, and movies. The line lags the picture by a few seconds. Base is lighter; Small uses more CPU and GPU. This does not use the microphone.";
"settings.liveCaptionModel.label" = "Model";
"settings.liveCaptionModel.desc" = "Multilingual Whisper models downloaded from Settings into Application Support. Base is about 150 MB. Small is about 500 MB and slower. A build does not download them.";
"settings.liveCaptionModel.items.0" = "Base (faster)";
"settings.liveCaptionModel.items.1" = "Small (more accurate)";
"settings.liveCaptionLatency.label" = "Latency";
"settings.liveCaptionLatency.desc" = "Low latency uses a 3 second window and one beam. Balanced uses 5 seconds and beam 3. Accuracy uses 8 seconds and beam 5. The line cannot appear before that audio has been heard, and the model adds more time.";
"settings.liveCaptionLatency.items.0" = "Low latency";
"settings.liveCaptionLatency.items.1" = "Balanced";
"settings.liveCaptionLatency.items.2" = "Accuracy";
"settings.liveCaptionSync.label" = "Sync mode";
"settings.liveCaptionSync.desc" = "Lines the words up with the voice. Files, movies, and catch-up are recognized ahead of the playhead, so playback is not delayed. Live TV holds the picture and the sound by a few seconds. Depth is estimated from the frame on screen, so it stays on that same delayed picture.";

