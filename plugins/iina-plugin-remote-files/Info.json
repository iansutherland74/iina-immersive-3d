{
  "name": "Remote Files",
  "identifier": "io.iina.remote-files",
  "version": "1.1.0",
  "author": {
    "name": "IINA Immersive 3D contributors",
    "url": "https://github.com/iansutherland74/iina-immersive-3d"
  },
  "description": "Browse WebDAV, FTP, FTPS, SMB, SFTP, Jellyfin, Plex, Emby, and DLNA. Resume, favourites, subtitles, and folder playlists stay in this plugin.",
  "entry": "main.js",
  "permissions": ["network-request", "file-system"],
  "allowedDomains": ["*"],
  "sidebarTab": {
    "name": "Remote"
  },
  "preferenceDefaults": {
    "servers": "[]",
    "sort": "name",
    "autoplay": "1",
    "resume": "{}",
    "history": "[]",
    "favourites": "[]"
  }
}
